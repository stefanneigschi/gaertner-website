   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Smiling senior woman applying anti-aging lotion to remove dark circles under eyes. Happy mature woman using cosmetic cream to hide wrinkles below eyes. Lady using day moisturizer.</rdf:li>
    </rdf:Alt>
   </dc:description>
